---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "dev::news", description = "Developer news, curated and delivered." } = Astro.props;
const pageTitle = title === "dev::news" ? title : `${title} | dev::news`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-logo">&gt; dev<span>::</span>news</a>
        <nav class="site-nav">
          <a href="/">feed</a>
          <a href="/tags/ai">ai</a>
          <a href="/tags/web">web</a>
          <a href="/tags/devops">devops</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&gt; dev::news &mdash; automated developer news, refreshed hourly</p>
      </div>
    </footer>
  </body>
</html>
