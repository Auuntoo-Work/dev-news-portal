---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const articles = (await getCollection("articles")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(articles, { pageSize: 5 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout>
  <div class="container">
    {page.currentPage === 1 && (
      <section class="hero">
        <h1>&gt; latest <span>developer</span> news</h1>
        <p>Curated articles on AI, web dev, languages, and DevOps — refreshed every hour by our AI editor.</p>
      </section>
    )}

    {page.currentPage > 1 && (
      <section class="hero">
        <h1>&gt; page <span>{page.currentPage}</span></h1>
      </section>
    )}

    <section class="articles-grid">
      {page.data.map((article) => {
        const date = article.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        });
        return (
          <a href={`/articles/${article.id}`} class="article-card">
            <div class="article-card-meta">
              {article.data.category && <span class="category">{article.data.category}</span>}
              <span>{date}</span>
              <span>{article.data.author}</span>
            </div>
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
            <div class="tags">
              {article.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </a>
        );
      })}
    </section>

    {page.lastPage > 1 && (
      <nav class="pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="pagination-link">&larr; newer</a>
        ) : (
          <span class="pagination-link disabled">&larr; newer</span>
        )}
        <span class="pagination-info">page {page.currentPage} / {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="pagination-link">older &rarr;</a>
        ) : (
          <span class="pagination-link disabled">older &rarr;</span>
        )}
      </nav>
    )}
  </div>
</BaseLayout>
